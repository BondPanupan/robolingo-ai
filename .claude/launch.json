{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "robolingo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "robolingo-storybook",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "storybook",
        "dev",
        "-p",
        "6006",
        "--no-open",
        "--ci"
      ],
      "port": 6006
    }
  ]
}
