# Port for `npm run dev` / `npm start` (default 3000). Read before Next boots,
# so it works from .env/.env.local here; a shell `PORT=...` still wins. Vercel ignores it.
PORT=3000

# LINE Messaging API channel (Developers Console → Messaging API)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# MongoDB connection string. Docker compose sets this itself; set it for `npm run dev` / Vercel:
#   Atlas:                mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/line-webchat
#   compose MongoDB (auth): mongodb://<user>:<pass>@localhost:27017/line-webchat?authSource=admin
#   (authSource=admin: the root user lives in the "admin" db; URL-encode @ : / in the password)
MONGODB_URI=

# Root user of the bundled MongoDB in docker-compose*.yml (dev defaults to robolingo / robolingo-dev)
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Basic Auth for the admin pages and /api (everything except /api/line/webhook).
# Required in production; share the values with reviewers privately, never in the README.
# Rotate by changing these in Vercel and redeploying.
BASIC_AUTH_USER=panupan
BASIC_AUTH_PASSWORD=panupan
